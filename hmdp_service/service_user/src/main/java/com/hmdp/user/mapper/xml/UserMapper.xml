<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hmdp.user.mapper.UserMapper">

    <select id="getByPhone" resultType="com.hmdp.model.entity.User">
        select * from tb_user where phone = #{phone}
    </select>
    <select id="getUserListWithOrder" resultType="com.hmdp.model.entity.User">
        select * from tb_user
        <where>
         id in <foreach collection="ids" item="id" separator="," open="(" close=")">#{id}</foreach>
        </where>
        order by <foreach collection="ids" item="id" separator="," open="field(id," close=")">#{id}</foreach>
    </select>
</mapper>